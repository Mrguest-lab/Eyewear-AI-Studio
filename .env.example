# AI gateway (server/index.ts) settings. Copy to .env on the SERVER only.
# Never put these keys in the frontend or commit a real .env file.

# Google Gemini image model (AI photoshoots, relight, AI angle views).
# Outputs carry Google's invisible SynthID watermark; the app asks users to consent.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: e.g. gemini-3-pro-image-preview for native 2K/4K output
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# Replicate (FLUX Kontext edits, Real-ESRGAN upscaling, background remover).
REPLICATE_API_TOKEN=""
# Optional model overrides ("owner/name" or "owner/name:version")
# REPLICATE_EDIT_MODEL="black-forest-labs/flux-kontext-pro"
# REPLICATE_UPSCALE_MODEL="nightmareai/real-esrgan"
# REPLICATE_BG_MODEL="851-labs/background-remover"

# Optional protection for your gateway
# ACCESS_TOKEN="choose-a-passcode"           # users enter it in the app's AI Backend tab
# ALLOWED_ORIGINS="https://mrguest-lab.github.io"

# PORT=8787
# SERVE_STATIC=true   # also serve the built frontend from ./dist

# APP_URL: injected by Google AI Studio when hosted there.
APP_URL="MY_APP_URL"
